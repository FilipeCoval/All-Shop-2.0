
{
  "rewrites": [
    {
      "source": "/api/checkout",
      "destination": "/api/admin/legacy"
    },
    {
      "source": "/api/cleanup-reservations",
      "destination": "/api/admin/legacy"
    },
    {
      "source": "/api/update-stock-summary",
      "destination": "/api/admin/legacy"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/product/(.*)",
      "destination": "/api/og?id=$1"
    },
    {
      "source": "/p/(.*)",
      "destination": "/api/og?id=$1"
    },
    {
      "source": "/home",
      "destination": "/api/og?id=home"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
