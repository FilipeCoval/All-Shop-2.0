# Gemini: usada APENAS pelo servidor /api/chat. Nunca use VITE_GEMINI_API_KEY.
GEMINI_API_KEY=
# Opcional: permite desligar o chat imediatamente sem deploy. Use false para desligar.
AI_CHAT_ENABLED=true
# Opcional: use um valor aleatório longo para tornar o identificador de limite mais privado.
AI_CHAT_RATE_LIMIT_SALT=

# Configurações do Firebase (necessárias no Vercel - Settings > Environment Variables)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=(default)

# Supabase (Backup Database)
VITE_SUPABASE_URL=https://lmpleqndkgsnalwwlzxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Firebase Admin (Necessário para Push Notifications em Vercel - Settings > Environment Variables)
FIREBASE_PROJECT_ID=allshop-store-70851
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@allshop-store-70851.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
