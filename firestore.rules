rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // GLOBAL DENY FALLBACK
    // =====================================================

    match /{document=**} {
      allow read, write: if false;
    }

    // =====================================================
    // HELPERS
    // =====================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() in [
          "filipe_coval_90@hotmail.com",
          "mcpoleca@gmail.com",
          "filipe@teste.com",
          "filipecoval90@gmail.com"
        ];
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // =====================================================
    // VALIDATORS
    // =====================================================

    function isValidUser(data) {
      return data.get('email', '') is string &&
             data.get('email', '').size() <= 150;
    }

    function isValidOrder(data) {
      return data.get('total', 0) is number &&
             data.get('status', '') is string &&
             data.get('status', '').size() <= 100;
    }

    function isValidProductRequest(data) {
      return data.get('userId', '') is string &&
             data.get('userId', '').size() <= 128 &&
             data.get('productName', '') is string &&
             data.get('productName', '').size() <= 200;
    }

    function isValidReview(data) {
      return data.get('productId', 0) is number &&
             data.get('userId', '') is string;
    }

    function isValidTicket(data) {
      return data.get('userId', '') is string;
    }

    function isValidReservation(data) {
      return data.get('productId', 0) is number;
    }

    function isValidOnlineUser(data) {
      return data.keys().hasAny(["type", "lastActive"]);
    }

    // AQUI ESTAVA O SEU ERRO CRÍTICO!
    function isValidId(id) {
      return id is string &&
             id.size() <= 128 &&
             // Permitir o caractere '#' que é usado nos seus IDs de encomenda! Ex: #AS-188581
             id.matches('^[#a-zA-Z0-9_\\-]+$');
    }

    // =====================================================
    // USERS
    // =====================================================

    match /users/{userId} {

      allow read: if isAdmin() ||
        (isSignedIn() && request.auth.uid == userId);

      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        isValidUser(incoming());

      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        isValidUser(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'photoURL',
          'phone',
          'nif',
          'addresses',
          'wishlist',
          'fcmToken',
          'deviceTokens',
          'notificationsEnabled',
          'lastShareDate',
          'birthday',
          'isGuest',
          'loyaltyPoints',
          'pointsHistory',
          'tier',
          'totalSpent'
        ])
      );

      allow delete: if isAdmin();
    }

    // =====================================================
    // ORDERS (🔥 PRO VERSION)
    // =====================================================

    match /orders/{orderId} {

      function isOwner() {
        // Para transacoes CREATE onde o doc nao existe
        let isNew = resource == null;
        
        let isUserOwner = isSignedIn() && !isNew && resource.data.userId == request.auth.uid;
        
        // Protege contra brute-force de IDs: guests so podem ler se for "Pendente" 
        // ou se estiverem a fazer um UPDATE valido (com o token no payload).
        let isGuestOwner = !isSignedIn() && !isNew && resource.data.keys().hasAll(['guestToken']) && resource.data.guestToken is string && (
          (request.resource == null && resource.data.status == 'Pendente') || 
          (request.resource != null && request.resource.data.guestToken == resource.data.guestToken)
        );

        return isNew || isUserOwner || isGuestOwner;
      }

      function isCreatingOwnOrder() {
        return (
          (isSignedIn() && request.resource.data.userId == request.auth.uid)
          ||
          (!isSignedIn() && request.resource.data.guestToken is string)
        );
      }

      // READ
      allow get: if isAdmin() || isOwner();

      allow list: if isAdmin() || isSignedIn();

      // CREATE
      allow create: if isValidId(orderId)
        && isValidOrder(request.resource.data)
        && (isAdmin() || isCreatingOwnOrder());

      // UPDATE
      allow update: if isValidId(orderId)
        && isValidOrder(request.resource.data)
        && (isAdmin() || isOwner());

      // DELETE
      allow delete: if isAdmin();
    }

    // =====================================================
    // PRODUCT REQUESTS
    // =====================================================

    match /product_requests/{requestId} {

      allow get: if isAdmin() ||
        (isSignedIn() && existing().userId == request.auth.uid);

      allow list: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn() &&
        incoming().userId == request.auth.uid &&
        isValidProductRequest(incoming());

      allow update: if isAdmin() ||
        (isSignedIn() && existing().userId == request.auth.uid);

      allow delete: if isAdmin() ||
        (isSignedIn() && existing().userId == request.auth.uid);
    }

    // =====================================================
    // PRODUCTS
    // =====================================================

    match /products_public/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products_inventory/{inventoryId} {
      allow read, write: if isAdmin();
    }

    match /store_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =====================================================
    // REVIEWS
    // =====================================================

    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        isValidReview(incoming()) &&
        incoming().userId == request.auth.uid;

      allow update: if isSignedIn() &&
        isValidReview(incoming()) &&
        (
          isAdmin() ||
          (existing().userId == request.auth.uid &&
           incoming().diff(existing()).affectedKeys().hasOnly([
             'rating', 'comment', 'images'
           ]))
        );

      allow delete: if isAdmin() ||
        (isSignedIn() && existing().userId == request.auth.uid);
    }

    // =====================================================
    // SUPPORT TICKETS
    // =====================================================

    match /support_tickets/{ticketId} {

      allow read: if isAdmin() ||
        (isSignedIn() && existing().userId == request.auth.uid);

      allow list: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn() &&
        isValidTicket(incoming()) &&
        incoming().userId == request.auth.uid;

      allow update: if isAdmin() ||
        (isSignedIn() && existing().userId == request.auth.uid);

      allow delete: if isAdmin();
    }

    // =====================================================
    // STOCK RESERVATIONS
    // =====================================================

    match /stock_reservations/{reservationId} {

      allow read: if true;
      allow create: if isValidReservation(incoming());
      allow update: if isValidReservation(incoming());
      allow delete: if true;
    }

    // =====================================================
    // COUPONS
    // =====================================================

    match /coupons/{couponId} {

      allow read: if true;

      allow create: if isAdmin();

      allow update: if isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly([
          'usageCount'
        ]);

      allow delete: if isAdmin();
    }

    // =====================================================
    // NEWSLETTER / LEADS / ALERTS
    // =====================================================

    match /newsletter_subscriptions/{subId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /stock_alerts/{alertId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // =====================================================
    // ADMIN SYSTEMS
    // =====================================================

    match /import_shipments/{shipmentId} {
      allow read, write: if isAdmin();
    }

    match /stock_movements/{movementId} {
      allow read, write: if isAdmin();
    }

    // =====================================================
    // ONLINE USERS
    // =====================================================

    match /online_users/{onlineUserId} {

      allow read: if true;

      allow create, update: if isSignedIn() &&
        isValidOnlineUser(incoming());

      allow delete: if isAdmin() ||
        (isSignedIn() && request.auth.uid == onlineUserId);
    }

    // =====================================================
    // PUBLIC SUMMARY
    // =====================================================

    match /public_stock_summary/{summaryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
