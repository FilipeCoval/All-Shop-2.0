rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.email in [
        "filipe_coval_90@hotmail.com",
        "mcpoleca@gmail.com",
        "filipe@teste.com",
        "filipecoval90@gmail.com"
      ]);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // -- VALIDATORS -- //

    function isValidUser(data) {
      return (data.get('email', '') is string && data.get('email', '').size() <= 150);
    }

    function isValidOrder(data) {
       return (data.get('total', 0) is number) &&
              (data.get('status', '') is string && data.get('status', '').size() <= 100);
    }

    function isValidReview(data) {
       return (data.get('productId', 0) is number) &&
              (data.get('userId', '') is string && data.get('userId', '').size() <= 128);
    }

    function isValidTicket(data) {
      return (data.get('userId', '') is string && data.get('userId', '').size() <= 128);
    }

    function isValidReservation(data) {
       return (data.get('productId', 0) is number);
    }
    
    function isValidNewsletter(data) {
       return (data.get('email', '') is string && data.get('email', '').size() <= 150);
    }

    function isValidLead(data) {
       return (data.get('email', '') is string && data.get('email', '').size() <= 150);
    }

    function isValidStockAlert(data) {
       return (data.get('email', '') is string && data.get('email', '').size() <= 150);
    }

    function isValidProductRequest(data) {
       return (data.get('userId', '') is string && data.get('userId', '').size() <= 128) &&
              (data.get('productName', '') is string && data.get('productName', '').size() <= 200) &&
              (data.get('category', '') is string) &&
              (data.get('state', '') is string) &&
              (data.get('urgency', '') is string) &&
              (data.get('specifications', '') is string) &&
              (data.get('details', '') is string) &&
              (data.get('budgetRange', '') is string) &&
              (data.get('notificationsEnabled', false) is bool);
    }

    function isValidOnlineUser(data) {
      // Allow any type, we just protect who writes it in the rule
      return data.keys().hasAny(["type", "lastActive"]);
    }


    // -- COLLECTIONS -- //

    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      // Create user profile
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      // Update fields
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'photoURL', 'phone', 'nif', 'addresses', 'wishlist', 'fcmToken', 'deviceTokens', 'notificationsEnabled', 'lastShareDate', 'birthday', 'isGuest', 'loyaltyPoints', 'pointsHistory', 'tier', 'totalSpent'
        ])
      );
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isAdmin() || (isSignedIn() && (existing().userId == request.auth.uid || existing().shippingInfo.email == request.auth.token.email));
      allow list: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.shippingInfo.email == request.auth.token.email));
      
      allow create: if isValidId(orderId) && 
                      incoming().keys().hasAll(["total", "status", "date", "items"]) &&
                      isValidOrder(incoming()) && (
        isAdmin() || (isSignedIn() && incoming().userId == request.auth.uid) || (!isSignedIn())
      );
      
      allow update: if isValidId(orderId) && (
        isAdmin() || 
        (isValidOrder(incoming()) && isSignedIn() && 
          (existing().userId == request.auth.uid || existing().shippingInfo.email == request.auth.token.email) && 
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        )
      );
      allow delete: if isAdmin();
    }

    match /products_public/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products_inventory/{inventoryId} {
      allow read, write: if isAdmin();
    }

    match /store_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidReview(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidReview(incoming()) && (
        isAdmin() || (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment', 'images']))
      );
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    match /support_tickets/{ticketId} {
      allow get: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidTicket(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid && isValidTicket(incoming()));
      allow delete: if isAdmin();
    }

    match /stock_reservations/{reservationId} {
      // Client needs to read and write these during checkout (like carts)
      allow read: if true; 
      allow create: if isValidReservation(incoming());
      allow update: if isValidReservation(incoming()); // Maybe extend reservation
      allow delete: if true; // Any client can clear expired reservations
    }

    match /coupons/{couponId} {
      allow read: if true; // Read to validate
      allow write: if isAdmin() || true; // Code generates usage (update usageCount locally)  - WARNING: Might need securing later if exploited
    }

    match /newsletter_subscriptions/{subId} {
      allow create: if isValidNewsletter(incoming());
      allow read, update, delete: if isAdmin();
    }

    match /leads/{leadId} {
      allow create: if isValidLead(incoming());
      allow read, update, delete: if isAdmin();
    }

    match /stock_alerts/{alertId} {
      allow create: if isValidStockAlert(incoming());
      allow read, update, delete: if isAdmin();
    }

    match /product_requests/{requestId} {
      allow get: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidProductRequest(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminComment']));
      allow delete: if isAdmin();
    }

    match /import_shipments/{shipmentId} {
      allow read, write: if isAdmin();
    }

    match /stock_movements/{movementId} {
      allow read, write: if isAdmin();
    }

    match /online_users/{onlineUserId} {
      allow read: if true;
      allow create: if isValidOnlineUser(incoming());
      allow update: if isValidOnlineUser(incoming());
      allow delete: if isAdmin() || true;
    }

    match /public_stock_summary/{summaryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
