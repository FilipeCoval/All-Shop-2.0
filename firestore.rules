rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email in [
        "filipe_coval_90@hotmail.com",
        "filipecoval90@gmail.com",
        "mcpoleca@gmail.com",
        "filipe@teste.com"
      ];
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Everything is closed unless a collection below explicitly allows it.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Public catalog. Checkout/stock is handled by Vercel server APIs.
    match /products_public/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /store_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Kept readable for the current coupon UI. Only admins/server can change coupons.
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
        || (isAuthenticated()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Customer profile. We intentionally keep normal profile updates available
    // until loyalty/referral updates are moved to server APIs in a later phase.
    // It does block role/admin escalation.
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isAdmin()
        || (isOwner(userId)
          && request.resource.data.get('role', 'Cliente') == 'Cliente'
          && request.resource.data.get('isAdmin', false) == false);
      allow update: if isAdmin()
        || (isOwner(userId)
          && request.resource.data.get('role', 'Cliente') == resource.data.get('role', 'Cliente')
          && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false));
      allow delete: if isAdmin();
    }

    // Presence documents are never public. The app may only maintain its own presence.
    match /online_users/{sessionId} {
      allow read: if isAdmin();
      allow create, update: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // CRITICAL: public browser access is now closed.
    // Checkout, tracking, customer orders and cancel/return requests use Vercel APIs
    // with Firebase Admin, which bypasses Firestore Rules.
    match /orders/{orderId} {
      allow read, write: if isAdmin();
    }

    match /stock_reservations/{reservationId} {
      allow read, write: if isAdmin();
    }

    match /products_inventory/{itemId} {
      allow read, write: if isAdmin();
    }

    // Support tickets: signed-in customers can create and access only their own tickets.
    match /support_tickets/{ticketId} {
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow read, update: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Product requests may be submitted publicly, but are never readable publicly.
    match /product_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /newsletter_subscriptions/{itemId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /import_shipments/{itemId} {
      allow read, write: if isAdmin();
    }

    match /stock_alerts/{itemId} {
      allow read, write: if isAdmin();
    }

    // Created by the server-side chat limiter only.
    match /ai_chat_limits/{itemId} {
      allow read, write: if isAdmin();
    }
  }
}
