rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "filipe_coval_90@hotmail.com" ||
        request.auth.token.email == "filipecoval90@gmail.com" ||
        request.auth.token.email == "mcpoleca@gmail.com" ||
        request.auth.token.email == "filipe@teste.com"
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOwnerByEmail(email) {
      return isAuthenticated()
        && request.auth.token.email != null
        && email == request.auth.token.email;
    }

    // Bloqueia tudo por defeito
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Produtos públicos
    match /products_public/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          // O cliente/guest pode atualizar o stock ao finalizar compras
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'variants'])
        );
    }

    match /store_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin()
        || (
          isAuthenticated()
          && resource.data.userId == request.auth.uid
        );
    }

    // Perfil do cliente
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);

      allow create: if isAdmin() || isOwner(userId);

      allow update: if isAdmin()
        || (
          isOwner(userId)

          // impede user de se tornar admin (acesso robusto usando .get para evitar erros se os campos não existirem)
          && request.resource.data.get('role', 'Cliente') == resource.data.get('role', 'Cliente')
          && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
        );

      allow delete: if isAdmin();
    }

    // Presença online
    match /online_users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin() || isOwner(userId);
    }

    // Encomendas
    match /orders/{orderId} {
      allow create: if true;

      allow read: if isAdmin()
        || (
          isAuthenticated()
          && resource.data.userId == request.auth.uid
        )
        || (
          isAuthenticated()
          && resource.data.shippingInfo.email == request.auth.token.email
        )
        || (
          isAuthenticated()
          && resource.data.customerEmail == request.auth.token.email
        )
        || (
          isAuthenticated()
          && resource.data.email == request.auth.token.email
        );

      // Permite ao admin gerir todas as encomendas.
      // Permite a atualização da encomenda do próprio cliente/guest caso esteja no estado 'Pendente' (ex: checkout ou adoção de encomenda guest).
      allow update: if isAdmin()
        || (
          existing().get('status', 'Pendente') == 'Pendente'
          && (
            existing().get('userId', null) == null
            || existing().get('userId', null) == request.auth.uid
          )
        );

      allow delete: if isAdmin();
    }

    // Tickets de suporte
    match /support_tickets/{ticketId} {
      allow create: if true;

      allow read: if isAdmin()
        || (
          isAuthenticated()
          && resource.data.userId == request.auth.uid
        )
        || (
          isAuthenticated()
          && resource.data.email == request.auth.token.email
        );

      allow update: if isAdmin()
        || (
          isAuthenticated()
          && resource.data.userId == request.auth.uid
        )
        || (
          isAuthenticated()
          && resource.data.email == request.auth.token.email
        );

      allow delete: if isAdmin();
    }

    // Pedidos de produtos
    match /product_requests/{requestId} {
      allow create: if true;

      allow read: if isAdmin()
        || (
          isAuthenticated()
          && resource.data.userId == request.auth.uid
        )
        || (
          isAuthenticated()
          && resource.data.email == request.auth.token.email
        );

      allow update: if isAdmin()
        || (
          isAuthenticated()
          && resource.data.userId == request.auth.uid
        )
        || (
          isAuthenticated()
          && resource.data.email == request.auth.token.email
        );

      allow delete: if isAdmin();
    }

    // Newsletter
    match /newsletter_subscriptions/{itemId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Reservas de stock/carrinho
    match /stock_reservations/{reservationId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Área privada/admin
    match /products_inventory/{itemId} {
      allow read: if true; // Permite ao checkout consultar o lote/variante correspondente
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          // O cliente pode atualizar as quantidades vendidas e reservadas no checkout
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantitySold', 'reserved'])
        );
    }

    match /import_shipments/{itemId} {
      allow read, write: if isAdmin();
    }

    match /stock_alerts/{itemId} {
      allow read, write: if isAdmin();
    }
  }
}

